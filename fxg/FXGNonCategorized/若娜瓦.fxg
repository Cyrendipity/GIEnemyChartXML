			<BitmapImage source="@Embed('/若娜瓦.assets/Image_3.png')" x="64" y="1197" blendMode="normal">
			</BitmapImage>
			<BitmapImage source="@Embed('/若娜瓦.assets/Image_4.png')" x="64" y="1261" blendMode="normal">
			</BitmapImage>
