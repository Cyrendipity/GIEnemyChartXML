		</BitmapImage>
		<BitmapImage source="@Embed('/烁晶之人.assets/Image_37.png')" x="1248" y="662" blendMode="normal">
		</BitmapImage>
		<BitmapImage source="@Embed('/烁晶之人.assets/Image_38.png')" x="1248" y="150" blendMode="normal">
		</BitmapImage>
		<RichText x="66" y="1200" fontFamily="仓耳渔阳体 W03" fontSize="16" fontStyle="normal" fontWeight="bold" color="#ffffff" width="407" height="20" kerning="off" blendMode="normal" whiteSpaceCollapse="preserve" alpha="0.7490196078431373">
			<content>
				<p fontFamily="仓耳渔阳体 W03" fontSize="16" fontWeight="bold" color="#ffffff">烁晶之人免疫其他枪械伤害，枪械只能用霰弹枪造成伤害。</p>
			</content>
		</RichText>
	</Group>
</Graphic>