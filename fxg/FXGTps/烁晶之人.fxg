		<RichText x="62" y="501" fontFamily="仓耳渔阳体 W04" fontSize="40" fontStyle="italic" fontWeight="normal" color="#ff9999" width="435" height="43" kerning="off" blendMode="normal" whiteSpaceCollapse="preserve" alpha="1">
			<content>
				<p fontFamily="仓耳渔阳体 W04" fontSize="40" fontStyle="italic" color="#ff9999">唯私心执行超越的个体</p>
			</content>
			<filters>
				<DropShadowFilter angle="40" color="#ffb399" distance="16" alpha="0.75" quality="2" blurX="25" blurY="25"/>
			</filters>
		</RichText>
		<RichText x="61" y="548" fontFamily="SDK_SC_Web" fontSize="20" fontStyle="italic" fontWeight="normal" color="#ff9999" width="352" height="49" kerning="off" blendMode="normal" whiteSpaceCollapse="preserve" alpha="0.7490196078431373">
			<content>
				<p fontFamily="SDK_SC_Web" fontSize="20" fontStyle="italic" color="#ff9999">One Who Transcends for Selfish Wishes Alone</p>
			</content>
			<filters>
				<DropShadowFilter angle="40" color="#ffb399" distance="16" alpha="0.75" quality="2" blurX="25" blurY="25"/>
			</filters>
		</RichText>
		<RichText x="899" y="62" fontFamily="造字工房悦圆 G0v1 常规体" fontSize="24" fontStyle="normal" fontWeight="normal" color="#99440b" width="207" height="28" kerning="off" blendMode="normal" whiteSpaceCollapse="preserve" alpha="1">
			<content>
				<p fontFamily="造字工房悦圆 G0v1 常规体" fontSize="24" color="#99440b">制图@Csxylic米游社</p>
			</content>
		</RichText>
		<RichText x="738" y="991" width="437" height="56" kerning="off" blendMode="normal" whiteSpaceCollapse="preserve" alpha="0.9019607843137255">
			<content>
				<p fontFamily="仓耳渔阳体 W03" fontSize="24" fontWeight="bold" color="#ffffff">烁晶人发射一枚赤龙晶，造成<span color="#b8b8b8">100%</span><span>伤害并摧毁掩体。</span></p>
			</content>
		</RichText>
		<RichText x="1410" y="991" width="439" height="143" kerning="off" blendMode="normal" whiteSpaceCollapse="preserve" alpha="0.9019607843137255">
			<content>
				<p fontFamily="仓耳渔阳体 W03" fontSize="24" fontWeight="bold" color="#ffffff">烁晶人移至场地中央，唤出2或4枚晶体，用16s后蓄力完成并发射，<span color="#ffdfbf">秒杀</span><span>前台。晶体需要使用霰弹枪攻击</span><span color="#ffdfbf">1</span><span>次才能破坏。破坏全部晶体会使烁晶人失去</span><span color="#ffdfbf">29.5%</span><span>生命值。</span></p>
			</content>
		</RichText>
		<BitmapImage source="@Embed('/烁晶之人.assets/Image_14.png')" x="720" y="905">
		</BitmapImage>
		<BitmapImage source="@Embed('/烁晶之人.assets/Image_15.png')" x="1392" y="905">
		</BitmapImage>
		<RichText x="738" y="223" width="438" height="85" kerning="off" blendMode="normal" whiteSpaceCollapse="preserve" alpha="0.9019607843137255">
			<content>
				<p fontFamily="仓耳渔阳体 W03" fontSize="24" fontWeight="bold" color="#ffffff">烁晶人进行2段的抓划攻击，均造成<span color="#99ffff">65%</span><span>伤害；若玩家位于侧方，则追加一段扫尾攻击造成</span><span color="#99ffff">80%</span><span>伤害。</span></p>
			</content>
		</RichText>
		<BitmapImage source="@Embed('/烁晶之人.assets/Image_16.png')" x="719" y="137">
		</BitmapImage>
		<BitmapImage source="@Embed('/烁晶之人.assets/Image_17.png')" x="596" y="171" blendMode="normal">
		</BitmapImage>
		<BitmapImage source="@Embed('/烁晶之人.assets/Image_18.png')" x="576" y="150" blendMode="normal">
		</BitmapImage>
		<BitmapImage source="@Embed('/烁晶之人.assets/Image_19.png')" x="719" y="394">
		</BitmapImage>
		<RichText x="738" y="479" width="434" height="85" kerning="off" blendMode="normal" whiteSpaceCollapse="preserve" alpha="0.9019607843137255">
			<content>
				<p fontFamily="仓耳渔阳体 W03" fontSize="24" fontWeight="bold" color="#ffffff">位于远处时，烁晶人凝结霜露，从中持续释放出约22枚追踪冰晶，均造成<span color="#99ffff">45%,<br/>22.5%,4.5%</span><span>伤害。</span></p>
			</content>
		</RichText>
		<BitmapImage source="@Embed('/烁晶之人.assets/Image_20.png')" x="596" y="427" blendMode="normal">
		</BitmapImage>
		<BitmapImage source="@Embed('/烁晶之人.assets/Image_21.png')" x="576" y="406" blendMode="normal">
		</BitmapImage>
		<RichText x="738" y="735" width="439" height="143" kerning="off" blendMode="normal" whiteSpaceCollapse="preserve" alpha="0.9019607843137255">
			<content>
				<p fontFamily="仓耳渔阳体 W03" fontSize="24" fontWeight="bold" color="#ffffff">烁晶人初始拥有厄生护罩，护罩两侧各拥有1枚灾石晶块，累计使用霰弹枪攻击<span color="#ffdfbf">6</span><span>次才可破坏。</span><span color="#ffbfbf">(斯露德)</span><span>间歇性出现护罩，需要用场地荧光光线聚焦击破。破坏使烁晶人失去</span><span color="#ffdfbf">20%</span><span>生命值。</span></p>
			</content>
		</RichText>
		<BitmapImage source="@Embed('/烁晶之人.assets/Image_22.png')" x="720" y="650">
		</BitmapImage>
		<BitmapImage source="@Embed('/烁晶之人.assets/Image_23.png')" x="596" y="683" blendMode="normal">
		</BitmapImage>
		<BitmapImage source="@Embed('/烁晶之人.assets/Image_24.png')" x="1268" y="939" blendMode="normal">
		</BitmapImage>
		<BitmapImage source="@Embed('/烁晶之人.assets/Image_25.png')" x="596" y="939" blendMode="normal">
		</BitmapImage>
		<BitmapImage source="@Embed('/烁晶之人.assets/Image_26.png')" x="576" y="918" blendMode="normal">
		</BitmapImage>
		<BitmapImage source="@Embed('/烁晶之人.assets/Image_27.png')" x="1248" y="918" blendMode="normal">
		</BitmapImage>
		<BitmapImage source="@Embed('/烁晶之人.assets/Image_28.png')" x="576" y="662" blendMode="normal">
		</BitmapImage>
		<BitmapImage source="@Embed('/烁晶之人.assets/Image_29.png')" x="64" y="64" blendMode="normal">
		</BitmapImage>
		<BitmapImage source="@Embed('/烁晶之人.assets/Image_30.png')" x="1392" y="137">
		</BitmapImage>
		<RichText x="1410" y="223" width="424" height="114" kerning="off" blendMode="normal" whiteSpaceCollapse="preserve" alpha="0.9019607843137255">
			<content>
				<p fontFamily="仓耳渔阳体 W03" fontSize="24" fontWeight="bold" color="#ffffff">位于远处时，烁晶人作势，短暂停留并迅速冲击，造成<span color="#99ffff">90%</span><span>伤害，通常施放2次。若为进行摧毁建筑物进行的冲击，则仅造成</span><span color="#99ffff">30%</span><span>伤害.</span></p>
			</content>
		</RichText>
		<RichText x="1410" y="479" width="423" height="56" kerning="off" blendMode="normal" whiteSpaceCollapse="preserve" alpha="0.9019607843137255">
			<content>
				<p fontFamily="仓耳渔阳体 W03" fontSize="24" fontWeight="bold" color="#ffffff">位于近处时，烁晶人将凝结尖冰，随后掷向地面爆裂，造成<span color="#99ffff">100%</span><span>伤害。</span></p>
			</content>
		</RichText>
		<RichText x="1410" y="735" width="424" height="56" kerning="off" blendMode="normal" whiteSpaceCollapse="preserve" alpha="0.9019607843137255">
			<content>
				<p fontFamily="仓耳渔阳体 W03" fontSize="24" fontWeight="bold" color="#ffffff">处于侧方时，烁晶人将直接进行甩尾攻击，造成<span color="#99ffff">80%</span><span>伤害。</span></p>
			</content>
		</RichText>
		<BitmapImage source="@Embed('/烁晶之人.assets/Image_31.png')" x="1391" y="394">
		</BitmapImage>
