		<RichText x="738" y="255" width="428" height="143" kerning="off" blendMode="normal" whiteSpaceCollapse="preserve" alpha="0.9019607843137255">
			<content>
				<p fontFamily="仓耳渔阳体 W03" fontSize="24" fontWeight="bold" color="#ffffff">帕芙琳娜使用双刃进行一次华丽的旋身攻击，造成<span color="#99ffff">100%</span><span>伤害，并留下3枚「浮冰」，短暂停留后朝玩家攻击，造成</span><span color="#99ffff">20%</span><span>伤害。「浮冰」可被击破，对帕芙琳娜造成</span><span color="#99ffff">20%</span><span>伤害。</span></p>
			</content>
		</RichText>
		<RichText x="738" y="511" width="438" height="56" kerning="off" blendMode="normal" whiteSpaceCollapse="preserve" alpha="0.9019607843137255">
			<content>
				<p fontFamily="仓耳渔阳体 W03" fontSize="24" fontWeight="bold" color="#ffffff">帕芙琳娜进行2段普通攻击，均造成<span color="#99ffff">75%</span><span>伤害，并留下3枚「浮冰」。</span></p>
			</content>
		</RichText>
		<BitmapImage source="@Embed('/永恒冰霜的幻景.assets/Image_17.png')" x="720" y="170">
		</BitmapImage>
		<BitmapImage source="@Embed('/永恒冰霜的幻景.assets/Image_18.png')" x="719" y="425">
		</BitmapImage>
		<BitmapImage source="@Embed('/永恒冰霜的幻景.assets/Image_19.png')" x="596" y="203" blendMode="normal">
		</BitmapImage>
		<BitmapImage source="@Embed('/永恒冰霜的幻景.assets/Image_20.png')" x="596" y="459" blendMode="normal">
		</BitmapImage>
		<BitmapImage source="@Embed('/永恒冰霜的幻景.assets/Image_21.png')" x="576" y="182" blendMode="normal">
		</BitmapImage>
		<BitmapImage source="@Embed('/永恒冰霜的幻景.assets/Image_22.png')" x="576" y="438" blendMode="normal">
		</BitmapImage>
		<BitmapImage source="@Embed('/永恒冰霜的幻景.assets/Image_23.png')" x="720" y="650">
		</BitmapImage>
		<BitmapImage source="@Embed('/永恒冰霜的幻景.assets/Image_24.png')" x="720" y="873">
		</BitmapImage>
		<RichText x="738" y="735" width="438" height="56" kerning="off" blendMode="normal" whiteSpaceCollapse="preserve" alpha="0.9019607843137255">
			<content>
				<p fontFamily="仓耳渔阳体 W03" fontSize="24" fontWeight="bold" color="#ffffff">帕芙琳娜突刺而来，造成<span color="#99ffff">100%</span><span>伤害，若玩家距离较近，则后接「流锷悬昙」。</span></p>
			</content>
		</RichText>
		<RichText x="738" y="959" width="438" height="85" kerning="off" blendMode="normal" whiteSpaceCollapse="preserve" alpha="0.9019607843137255">
			<content>
				<p fontFamily="仓耳渔阳体 W03" fontSize="24" fontWeight="bold" color="#ffffff">帕芙琳娜驭使棱箭，以三枚一组的方式施放追踪玩家，均造成<span color="#99ffff">15%</span><span>伤害，施放4次后结束。</span></p>
			</content>
		</RichText>
		<BitmapImage source="@Embed('/永恒冰霜的幻景.assets/Image_25.png')" x="596" y="683" blendMode="normal">
		</BitmapImage>
		<BitmapImage source="@Embed('/永恒冰霜的幻景.assets/Image_26.png')" x="596" y="907" blendMode="normal">
		</BitmapImage>
		<BitmapImage source="@Embed('/永恒冰霜的幻景.assets/Image_27.png')" x="576" y="662" blendMode="normal">
		</BitmapImage>
		<BitmapImage source="@Embed('/永恒冰霜的幻景.assets/Image_28.png')" x="576" y="886" blendMode="normal">
		</BitmapImage>
		<RichText x="738" y="1183" width="424" height="143" kerning="off" blendMode="normal" whiteSpaceCollapse="preserve" alpha="0.9019607843137255">
			<content>
				<p fontFamily="仓耳渔阳体 W03" fontSize="24" fontWeight="bold" color="#ffffff">帕芙琳娜在低于<span color="#ffdfbf">50%生命值</span><span>时，会将自己封入「</span><span textDecoration="underline">冰棺</span><span>」。「浮冰」会不断在冰棺附近产生，并朝玩家攻击。冰雾会在附近产生，持续造成</span><span color="#99ffff">3.125%</span><span>伤害。</span><span color="#ffbfff">[绝境]</span><span>冰棺将恢复</span><span color="#ffdfbf">30%生命值</span><span>。</span></p>
			</content>
		</RichText>
		<RichText x="738" y="1438" width="434" height="114" kerning="off" blendMode="normal" whiteSpaceCollapse="preserve" alpha="0.9019607843137255">
			<content>
				<p fontFamily="仓耳渔阳体 W03" fontSize="24" fontWeight="bold" color="#ffbfff">[绝境]<span color="#ffffff">帕芙琳娜每隔约</span><span color="#ffdfbf">44s</span><span color="#ffffff">，召唤冰牢禁锢玩家</span><span color="#ffdfbf">15s</span><span color="#ffffff">，解除之后造成</span><span color="#99ffff">150%</span><span color="#ffffff">伤害。期间帕芙琳娜不攻击，周围会出现2枚「霜花」，全部击破可解除禁锢。</span></p>
			</content>
		</RichText>
