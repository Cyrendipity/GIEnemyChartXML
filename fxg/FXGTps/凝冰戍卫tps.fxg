		<BitmapImage source="@Embed('/凝冰戍卫tps.assets/Image_13.png')" x="1393" y="137">
		</BitmapImage>
		<BitmapImage source="@Embed('/凝冰戍卫tps.assets/Image_14.png')" x="1392" y="425">
		</BitmapImage>
