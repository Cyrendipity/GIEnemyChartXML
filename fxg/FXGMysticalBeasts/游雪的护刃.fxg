		<BitmapImage source="@Embed('/游雪的护刃.assets/Image_14.png')" x="1392" y="138">
		</BitmapImage>
		<BitmapImage source="@Embed('/游雪的护刃.assets/Image_15.png')" x="1392" y="425">
		</BitmapImage>
		<BitmapImage source="@Embed('/游雪的护刃.assets/Image_16.png')" x="1392" y="713">
		</BitmapImage>
		<RichText x="1410" y="223" width="438" height="56" kerning="off" blendMode="normal" whiteSpaceCollapse="preserve" alpha="0.9019607843137255">
			<content>
				<p fontFamily="仓耳渔阳体 W03" fontSize="24" fontWeight="bold" color="#ffffff">雪精突刺而来，造成<span color="#99ffff">100%</span><span>伤害，若玩家距离较近，则后接「冬锷游锋」。</span></p>
			</content>
		</RichText>
		<RichText x="1410" y="511" width="439" height="56" kerning="off" blendMode="normal" whiteSpaceCollapse="preserve" alpha="0.9019607843137255">
			<content>
				<p fontFamily="仓耳渔阳体 W03" fontSize="24" fontWeight="bold" color="#ffffff">雪精召唤6枚冰棱箭，以三枚一组的方式施放追踪玩家，均造成<span color="#99ffff">25%</span><span>伤害。</span></p>
			</content>
		</RichText>
		<RichText x="1410" y="799" width="439" height="114" kerning="off" blendMode="normal" whiteSpaceCollapse="preserve" alpha="0.9019607843137255">
			<content>
				<p fontFamily="仓耳渔阳体 W03" fontSize="24" fontWeight="bold" color="#ffffff">雪精展开「冰棺」的同时，会在上空不断生成6枚冰长枪，并在蓄力完成后依次朝玩家发射而来，均造成<span color="#99ffff">60%,6%</span><span>伤害，同时额外造成</span><span color="#99ffff">15%</span><span>伤害。</span></p>
			</content>
		</RichText>
		<RichText x="899" y="62" fontFamily="造字工房悦圆 G0v1 常规体" fontSize="24" fontStyle="normal" fontWeight="normal" color="#2686a2" width="207" height="28" kerning="off" blendMode="normal" whiteSpaceCollapse="preserve" alpha="1">
			<content>
				<p fontFamily="造字工房悦圆 G0v1 常规体" fontSize="24" color="#2686a2">制图@Csxylic米游社</p>
			</content>
		</RichText>
		<RichText x="738" y="223" width="399" height="56" kerning="off" blendMode="normal" whiteSpaceCollapse="preserve" alpha="0.9019607843137255">
			<content>
				<p fontFamily="仓耳渔阳体 W03" fontSize="24" fontWeight="bold" color="#ffffff">雪精使用双刃进行一次华丽的旋身攻击，造成<span color="#99ffff">80%</span><span>伤害。</span></p>
			</content>
		</RichText>
		<RichText x="738" y="511" width="439" height="85" kerning="off" blendMode="normal" whiteSpaceCollapse="preserve" alpha="0.9019607843137255">
			<content>
				<p fontFamily="仓耳渔阳体 W03" fontSize="24" fontWeight="bold" color="#ffffff">雪精进行至多4段的普通攻击，运动幅度越来越大，依次造成<span color="#99ffff">30%,30%,40%,<br/>40%</span><span>伤害。</span></p>
			</content>
		</RichText>
		<RichText x="738" y="799" width="437" height="200" kerning="off" blendMode="normal" whiteSpaceCollapse="preserve" alpha="0.9019607843137255">
			<content>
				<p fontFamily="仓耳渔阳体 W03" fontSize="24" fontWeight="bold" color="#ffffff">雪精在低于<span color="#ffdfbf">50%生命值</span><span>时，会将自己封入「</span><span textDecoration="underline">冰棺</span><span>」；展开「冰棺」进行蓄力时会在周围产生冰风暴，持续造成</span><span color="#99ffff">3.125%</span><span>伤害，</span><span color="#ffdfbf">16s</span><span>后解除并施放「凝秉六境」，同时恢复</span><span color="#ffdfbf">20%生命值</span><span>，仅触发一次。受</span><span color="#bfdfff">「星烁反应」</span><span>影响，冰棺会更容易被</span><span color="#ffacff">雷元素</span><span>/</span><span color="#7fffd7">风元素</span><span>破坏。</span></p>
			</content>
		</RichText>
		<BitmapImage source="@Embed('/游雪的护刃.assets/Image_17.png')" x="720" y="137">
		</BitmapImage>
		<BitmapImage source="@Embed('/游雪的护刃.assets/Image_18.png')" x="719" y="425">
		</BitmapImage>
		<BitmapImage source="@Embed('/游雪的护刃.assets/Image_19.png')" x="719" y="713">
		</BitmapImage>
		<RichText x="738" y="1024" width="434" height="58" kerning="off" blendMode="normal" whiteSpaceCollapse="preserve" alpha="0.7490196078431373">
			<content>
				<p fontFamily="仓耳渔阳体 W03" fontSize="16" fontWeight="bold" color="#ffffff">冰棺：<span color="#99ffff">20冻</span><span>盾/</span><span color="#99ffff">40冻</span><span>盾</span><span color="#ffdfbf">(深渊)</span><span>，击破会使其</span><span color="#ffdfbf">扣除20%生命值</span><span>，同时虚弱</span><span color="#ffdfbf">15s</span><span>。</span><span color="#bfdfff">「星烁反应」</span><span>会使</span><span color="#ffacff">雷</span><span>/</span><span color="#7fffd7">风</span><span>的相应反应消耗比变为</span><span color="#ffdfbf">1:4</span><span>。</span></p>
			</content>
		</RichText>
		<RichText x="63" y="501" fontFamily="仓耳渔阳体 W04" fontSize="40" fontStyle="italic" fontWeight="normal" color="#99ffff" width="236" height="43" kerning="off" blendMode="normal" whiteSpaceCollapse="preserve" alpha="1">
			<content>
				<p fontFamily="仓耳渔阳体 W04" fontSize="40" fontStyle="italic" color="#99ffff">离群的冰影</p>
			</content>
			<filters>
				<DropShadowFilter angle="40" color="#99e5ff" distance="16" alpha="0.75" quality="2" blurX="25" blurY="25"/>
			</filters>
		</RichText>
