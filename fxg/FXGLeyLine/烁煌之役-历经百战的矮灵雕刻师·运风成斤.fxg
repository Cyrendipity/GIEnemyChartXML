			<content>
				<p fontFamily="仓耳渔阳体 W03" fontSize="16" fontWeight="bold" color="#ffbfbf">(N5)<span color="#ffffff"> 受到冰块爆炸伤害时，风抗下降</span><span color="#ffdfbf">25%</span><span color="#ffffff">，其余抗性下降</span><span color="#ffdfbf">20%</span><span color="#ffffff">，可叠加3层。</span></p>
			</content>
		</RichText>
		<BitmapImage source="@Embed('/烁煌之役-历经百战的矮灵雕刻师%B7运风成斤.assets/Image_17.png')" x="656" y="848" blendMode="normal">
		</BitmapImage>
