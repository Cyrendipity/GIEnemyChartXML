		<BitmapImage source="@Embed('/烁煌之役-游雪的护刃%B7不绝余音.assets/Image_18.png')" x="814" y="846" blendMode="normal">
		</BitmapImage>
		<RichText x="816" y="932" fontFamily="MiSans" fontSize="16" fontStyle="normal" fontWeight="bold" color="#ff9999" width="115" height="22" kerning="off" blendMode="normal" whiteSpaceCollapse="preserve" alpha="0.6">
			<content>
				<p textAlign="center" fontFamily="MiSans" fontSize="16" fontWeight="bold" color="#ff9999">Pyro Adv.</p>
			</content>
			<filters>
				<DropShadowFilter angle="40" color="#000000" distance="16" alpha="0.75" quality="2" blurX="25" blurY="25"/>
			</filters>
		</RichText>
		<RichText x="68" y="512" width="216" height="20" kerning="off" blendMode="normal" whiteSpaceCollapse="preserve" alpha="0.9019607843137255">
			<content>
				<p fontFamily="仓耳渔阳体 W03" fontSize="16" fontWeight="bold" color="#ffbfbf">(N5)<span color="#bfffbf"> </span><span color="#ffffff">抗性：</span><span color="#99ffff">冰元素</span><span color="#ffffff">抗性</span><span color="#ffdfbf">-40%</span><span color="#ffffff">。</span></p>
			</content>
		</RichText>
		<RichText x="67" y="864" width="138" height="26" kerning="off" blendMode="normal" whiteSpaceCollapse="preserve" alpha="1">
			<content>
				<p fontFamily="MiSans" fontSize="20" fontWeight="bold" color="#ffbfbf">(N5) <span color="#ffffff">冰明屏障：</span></p>
			</content>
		</RichText>
		<RichText x="66" y="896" width="505" height="78" kerning="off" blendMode="normal" whiteSpaceCollapse="preserve" alpha="0.9019607843137255">
			<content>
				<p fontFamily="仓耳渔阳体 W03" fontSize="16" fontWeight="bold" color="#ffffff">为冰棺受<span color="#bfdfff">「星烁反应」</span><span>影响后，根据冰棺剩余量转变而来，屏障厚度最大为</span><span color="#ffdfbf">15%生命值</span><span>，最大持续</span><span color="#ffdfbf">20s</span><span>。击破后将使雪精虚弱</span><span color="#ffdfbf">10s</span><span>，并对雪精造成两段伤害，其值分别为：</span><span color="#ffdfbf">10%生命值的真伤</span><span>，屏障期间所受</span><span color="#ffdfbf">60%伤害</span><span>(不超过</span><span color="#ffdfbf">10%雪精生命值</span><span>)的</span><span color="#ffdfbf">普通伤害</span><span>。</span></p>
			</content>
		</RichText>
		<RichText x="1538" y="320" width="440" height="108" kerning="off" blendMode="normal" whiteSpaceCollapse="preserve" alpha="0.9019607843137255">
			<content>
				<p fontFamily="仓耳渔阳体 W03" fontSize="18" fontWeight="bold" color="#ffffff">雪精在低于<span color="#ffdfbf">80%生命值</span><span>时，会将自己封入「</span><span textDecoration="underline">冰棺</span><span>」；展开「冰棺」进行蓄力时会在周围产生冰风暴，持续造成</span><span color="#99ffff">3.125%</span><span>伤害，</span><span color="#ffdfbf">16s</span><span>后解除并施放「凝秉六境」，同时恢复</span><span color="#ffdfbf">10%生命值</span><span>。受</span><span color="#bfdfff">「星烁反应」</span><span>影响，冰棺会转为「</span><span textDecoration="underline">冰明屏障</span><span>」，同时冰风暴消失。</span></p>
			</content>
		</RichText>
		<BitmapImage source="@Embed('/烁煌之役-游雪的护刃%B7不绝余音.assets/Image_19.png')" x="1519" y="233">
