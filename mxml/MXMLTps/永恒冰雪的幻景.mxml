	<mx:Text styleName="textStyle14" x="736" y="672" width="448" text="云泻州河-位移"/>
	<mx:Text styleName="textStyle14" x="736" y="896" width="448" text="死寒裂魄-远程"/>
	<mx:Text styleName="textStyle13" x="736" y="736" width="448" alpha="0.9" text="帕芙琳娜突刺而来，造成100%伤害，若玩家距离较近，则后接「流锷悬昙」。"/>
	<mx:Text styleName="textStyle13" x="736" y="960" width="448" alpha="0.9" text="帕芙琳娜驭使棱箭，以三枚一组的方式施放追踪玩家，均造成15%伤害，施放4次后结束。"/>
	<mx:Image source="Image12.png" x="596" y="683" width="128" height="128"/>
	<mx:Image source="Image13.png" x="596" y="907" width="128" height="128"/>
	<mx:Image source="Image14.png" x="576" y="662" width="168" height="170"/>
	<mx:Image source="Image15.png" x="576" y="886" width="168" height="170"/>
	<mx:Text styleName="textStyle13" x="736" y="1184" width="448" alpha="0.9" text="帕芙琳娜在低于50%生命值时，会将自己封入「冰棺」。「浮冰」会不断在冰棺附近产生，并朝玩家攻击。冰雾会在附近产生，持续造成3.125%伤害。[绝境]冰棺将恢复30%生命值。"/>
	<mx:Text styleName="textStyle15" x="736" y="1440" width="448" alpha="0.9" text="[绝境]帕芙琳娜每隔约44s，召唤冰牢禁锢玩家15s，解除之后造成150%伤害。期间帕芙琳娜不攻击，周围会出现2枚「霜花」，全部击破可解除禁锢。"/>
