	<mx:Text styleName="textStyle13" x="736" y="256" width="448" alpha="0.9" text="帕芙琳娜使用双刃进行一次华丽的旋身攻击，造成100%伤害，并留下3枚「浮冰」，短暂停留后朝玩家攻击，造成20%伤害。「浮冰」可被击破，对帕芙琳娜造成20%伤害。"/>
	<mx:Text styleName="textStyle13" x="736" y="512" width="448" alpha="0.9" text="帕芙琳娜进行2段普通攻击，均造成75%伤害，并留下3枚「浮冰」。"/>
	<mx:Text styleName="textStyle14" x="736" y="192" width="448" text="流锷悬昙-输出"/>
	<mx:Text styleName="textStyle14" x="736" y="448" width="448" text="饰霜铸影-输出"/>
