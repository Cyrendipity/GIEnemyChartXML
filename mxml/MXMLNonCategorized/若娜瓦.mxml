	<mx:Text styleName="textStyle7" x="64" y="753" width="395" alpha="0.75" text="Ronova"/>
	<mx:Text styleName="textStyle8" x="64" y="867" width="395" alpha="0.75" text="Arbiter of the Heavenly Principles &amp;Paralogism’s Outcast"/>
	<mx:Image source="Image4.png" x="64" y="1197" width="484" height="124"/>
	<mx:Text id="仆↓人进行至多5段的普通攻击，其依次造成2" styleName="textStyle9" x="1408" y="224" width="448" alpha="0.9" text="若娜瓦窃取角色的灵魂，并使队伍进入「裂魂」状态，同时抽走60%的「性命」。"/>
	<mx:Text id="仆↓人进行至多5段的普通攻击，其依次造成22" styleName="textStyle9" x="1408" y="448" width="448" alpha="0.9" text="若娜瓦施放交叉状的朱赤羽击，均造成50%伤害。该朱赤羽击还会在角色陷入「裂魂」状态下周期性出现。"/>
	<mx:Text id="仆↓人进行至多5段的普通攻击，其依次造成23" styleName="textStyle9" x="1408" y="672" width="448" alpha="0.9" text="若娜瓦在角色处召出死花，随后在圆形范围内盛开，造成100%伤害。"/>
	<mx:Text id="仆↓人进行至多5段的普通攻击，其依次造成24" styleName="textStyle9" x="1408" y="896" width="448" alpha="0.9" text="当某一角色的「性命」降至2%时，若娜瓦迅速抓起该角色，并将其生命值消耗至6%，之后的消耗过程将被戴因截断。"/>
	<mx:Text id="仆↓人进行至多5段的普通攻击，其依次造成25" styleName="textStyle9" x="1408" y="1120" width="448" alpha="0.9" text="若娜瓦在周身处召唤3只环绕自身的黑鸦，并产生血浪，造成50%伤害。黑鸦会在若娜瓦每次翻身时释放追踪玩家，每只造成66%伤害；黑鸦2.5s后消失。"/>
	<mx:Text id="仆↓人进行至多5段的普通攻击，其依次造成26" styleName="textStyle9" x="1408" y="1344" width="448" alpha="0.9" text="若娜瓦在角色处召出死花，随后在圆形范围内盛开，造成100%伤害，盛开产生的残烟形成火龙卷，触碰持续造成10%伤害，火龙卷会缓缓向玩家位置移动。"/>
	<mx:Text id="仆↓人进行至多5段的普通攻击，其依次造成27" styleName="textStyle9" x="1408" y="1568" width="448" alpha="0.9" text="若娜瓦召唤死之鸦，令其重重坠地，造成100%伤害。"/>
	<mx:Text id="仆↓人进行至多5段的普通攻击，其依次造成28" styleName="textStyle9" x="1408" y="1792" width="448" alpha="0.9" text="若娜瓦摧毁场地上所有的灾厄之眼和火龙卷，分别造成60%与80%伤害，同时释放所有的随身黑鸦。"/>
	<mx:Text styleName="textStyle10" x="1408" y="160" width="448" text="魂止生息渡-妨害"/>
	<mx:Text styleName="textStyle10" x="1408" y="384" width="448" text="朱羽汇玄阴-输出"/>
	<mx:Text styleName="textStyle10" x="1408" y="608" width="448" text="苦土逢凶蕊-定点"/>
	<mx:Text styleName="textStyle10" x="1408" y="832" width="448" text="灵空躯长留-控制"/>
	<mx:Text styleName="textStyle10" x="1408" y="1056" width="448" text="命辞墨翎啼-召唤	 降格"/>
	<mx:Text styleName="textStyle10" x="1408" y="1280" width="448" text="冥殁葬血芳-输出	 降格"/>
	<mx:Text styleName="textStyle10" x="1408" y="1504" width="448" text="孤翼送妄徒-猛攻	 降格"/>
	<mx:Text styleName="textStyle10" x="1408" y="1728" width="448" text="黑怖浓尘至-输出	 降格"/>
	<mx:Text styleName="textStyle11" x="896" y="64" width="228" text="制图@Csxylic米游社"/>
	<mx:Text styleName="textStyle12" x="64" y="1328" width="448" alpha="0.75" text="「性命」：初始被若娜瓦重置为50%，「裂魂」状态下每秒流失3%，受到若娜瓦攻击-15%，获得灵魂「生命」时+20%，「魂止生息渡」技能-60%。当该值降至2%时会被若娜瓦抓住，并被抽走真正的生命值。"/>
	<mx:Text styleName="textStyle12" x="64" y="1408" width="448" alpha="0.75" text="降格：若娜瓦被没收死之权能后的技能。"/>
	<mx:Text styleName="textStyle9" x="736" y="224" width="448" alpha="0.9" text="若娜瓦入场，扬起血浪，并产生沿八个方向扩散的数个地喷，均造成60%伤害。"/>
	<mx:Text styleName="textStyle9" x="736" y="448" width="448" alpha="0.9" text="若娜瓦展开蕴含赤月之力的眼翼，并发射6枚血弹，均造成25%伤害；"/>
	<mx:Text styleName="textStyle9" x="736" y="672" width="448" alpha="0.9" text="若娜瓦召唤数个呈直线方向扩散的地喷，均造成60%伤害。"/>
	<mx:Text styleName="textStyle9" x="736" y="1120" width="448" alpha="0.9" text="若娜瓦升至空中，使用「死之权能」，将在场角色送入死后世界。"/>
	<mx:Text styleName="textStyle9" x="736" y="1344" width="448" alpha="0.9" text="若娜瓦召唤数个呈直线方向扩散的大型地喷，均造成60%伤害，同时每个地喷都会留下灾厄之眼，触碰持续造成20%伤害。"/>
	<mx:Text styleName="textStyle9" x="736" y="1568" width="448" alpha="0.9" text="处于若娜瓦后方时，若娜瓦挥手发射一群平飞的黑鸦，造成66%伤害。"/>
	<mx:Text styleName="textStyle9" x="736" y="1792" width="448" alpha="0.9" text="若娜瓦持续将玩家牵引至面前，随后发动气爆，造成70%伤害。"/>
	<mx:Text styleName="textStyle9" x="736" y="2016" width="1024" alpha="0.9" text="若娜瓦将角色传至面前，施放「死之洪流」，将该角色(除主角外)的灵魂裂分为3个「生命」，同时使队伍进入「裂魂」状态：队伍的血条替换为特殊的「性命」条，并重置为50%；朱赤羽击将不断出现在玩家附近，且玩家不能够切换角色；20s后结束「裂魂」状态。主角免疫「裂魂」效果。"/>
	<mx:Text styleName="textStyle9" x="736" y="896" width="448" alpha="0.9" text="靠近若娜瓦时，会触发近身血浪，造成100%伤害。"/>
	<mx:Text styleName="textStyle10" x="736" y="160" width="448" text="折天惊魄处-猛攻"/>
	<mx:Text styleName="textStyle10" x="736" y="384" width="448" text="赤瞳斜月影-远程"/>
	<mx:Text styleName="textStyle10" x="736" y="608" width="448" text="灼目将离望-输出"/>
	<mx:Text styleName="textStyle10" x="736" y="1056" width="448" text="权当视生死-爆发"/>
	<mx:Text styleName="textStyle10" x="736" y="1280" width="448" text="虹目濒赐亡-猛攻	 降格"/>
	<mx:Text styleName="textStyle10" x="736" y="1504" width="448" text="烬风卷黑翳-远程	 降格"/>
	<mx:Text styleName="textStyle10" x="736" y="1728" width="448" text="却离攫手驻-控制	 降格"/>
	<mx:Text styleName="textStyle10" x="736" y="1952" width="448" text="裂魄散烟林-控制"/>
	<mx:Text styleName="textStyle10" x="736" y="832" width="448" text="昏寂漫灰朽-防御"/>
