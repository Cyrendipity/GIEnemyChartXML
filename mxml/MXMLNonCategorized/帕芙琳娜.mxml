	<mx:Text styleName="textStyle8" x="1408" y="160" width="448" text="云泻州河-位移"/>
	<mx:Text styleName="textStyle8" x="1408" y="384" width="448" text="死寒裂魄-远程"/>
	<mx:Text styleName="textStyle8" x="1408" y="608" width="448" text="驻予芳绚-防御"/>
	<mx:Text styleName="textStyle9" x="1408" y="224" width="448" alpha="0.9" text="帕芙琳娜突刺而来，造成100%伤害，若玩家距离较近，则后接「流锷悬昙」。"/>
	<mx:Text styleName="textStyle9" x="1408" y="448" width="448" alpha="0.9" text="帕芙琳娜驭使棱箭，以三枚一组的方式施放追踪玩家，接触及爆裂均造成30%伤害，施放4次后结束。"/>
	<mx:Text styleName="textStyle9" x="1408" y="672" width="448" alpha="0.9" text="被击退时，帕芙琳娜原地留下一朵大型「雪昙」，短暂绽放后造成60%伤害。"/>
	<mx:Text styleName="textStyle10" x="896" y="64" width="228" text="制图@Csxylic米游社"/>
	<mx:Text styleName="textStyle9" x="736" y="224" width="448" alpha="0.9" text="帕芙琳娜使用双刃进行一次华丽的旋身攻击，造成100%伤害，并留下3枚「雪昙」，短暂绽放后造成40%伤害。"/>
	<mx:Text styleName="textStyle9" x="736" y="448" width="448" alpha="0.9" text="帕芙琳娜进行2段普通攻击，均造成75%伤害，并留下3枚「雪昙」，短暂绽放后造成40%伤害。"/>
	<mx:Text styleName="textStyle9" x="736" y="672" width="448" alpha="0.9" text="战斗开始或生命值达50%时，帕芙琳娜移至场地中央，召唤大量「雪昙」从天上落下，造成40%伤害。期间帕芙琳娜锁血。"/>
	<mx:Text styleName="textStyle8" x="736" y="160" width="448" text="流锷悬昙-输出"/>
