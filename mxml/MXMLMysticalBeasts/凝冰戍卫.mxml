	<mx:Text styleName="textStyle" x="64" y="384" width="435" text="凝冰戍卫"/>
	<mx:Text styleName="textStyle2" x="576" y="64" width="522" text="全技能一图流"/>
	<mx:Text styleName="textStyle3" x="64" y="736" width="305" alpha="0.9" text="抗性数据(单位%)"/>
	<mx:Text styleName="textStyle4" x="1247" y="64" width="609" alpha="0.5" text="元素能量：CP[66,33,0]"/>
	<mx:Text styleName="textStyle5" x="64" y="576" width="305" text="HP: 332760 (6.0F)"/>
	<mx:Text styleName="textStyle6" x="64" y="544" width="305" alpha="0.75" text="普通 Lv.100 Data"/>
	<mx:Text styleName="textStyle5" x="64" y="624" width="375" text="ATK: 14773 (6.0B2)"/>
	<mx:Text styleName="textStyle5" x="64" y="672" width="375" text="Wt/Ed: 150/210"/>
	<mx:Text styleName="textStyle7" x="64" y="465" width="395" alpha="0.75" text="Glacial Warden"/>
	<mx:Image source="Image3.png" x="64" y="781" width="484" height="124"/>
	<mx:Text styleName="textStyle8" x="1408" y="160" width="448" text="雪砌冰铓-输出"/>
	<mx:Text styleName="textStyle9" x="1408" y="448" width="448" text="素尘扑影-输出"/>
	<mx:Text styleName="textStyle9" x="1408" y="736" width="448" text="冰躯怜椁-回复"/>
	<mx:Text styleName="textStyle10" x="1408" y="224" width="448" alpha="0.9" text="戍卫凝成霜锤，进行2次的挥动攻击，依次造成60%,70%伤害。"/>
	<mx:Text styleName="textStyle10" x="1408" y="512" width="448" alpha="0.9" text="戍卫凝成霜锤，将其击地，扬起雪尘，来回两次，均造成60%伤害。"/>
	<mx:Text styleName="textStyle10" x="1408" y="800" width="448" alpha="0.9" text="戍卫在低于50%生命值时，会将自己封入「冰棺」，16s后解除，并恢复50%生命值，仅触发一次。受「星烁反应」影响，冰棺会更容易被雷元素/风元素破坏。"/>
	<mx:Text styleName="textStyle11" x="896" y="64" width="228" text="制图@Csxylic米游社"/>
	<mx:Text styleName="textStyle10" x="736" y="224" width="448" alpha="0.9" text="戍卫使用右手进行拳击，造成50%伤害，接着短暂蓄力后发出强力拳，造成80%伤害。"/>
	<mx:Text styleName="textStyle10" x="736" y="512" width="448" alpha="0.9" text="距离较远时，戍卫结出3枚寒晶，迸射而来，造成80%,8%伤害。"/>
	<mx:Text styleName="textStyle10" x="736" y="800" width="448" alpha="0.9" text="距离较远时，戍卫就着霜锤飞跃而来，重重落地造成100%伤害。"/>
	<mx:Text styleName="textStyle9" x="736" y="160" width="448" text="霜疾突拳-输出"/>
	<mx:Text styleName="textStyle9" x="736" y="448" width="448" text="晶光雾华-远程"/>
	<mx:Text styleName="textStyle9" x="736" y="736" width="448" text="银瀑冬流-猛攻"/>
	<mx:Text styleName="textStyle12" x="64" y="912" width="448" alpha="0.75" text="免疫冻结。冰棺：16冻盾，击破会直接击败戍卫。「星烁反应」会使雷/风的相应反应消耗比变为1:4。"/>
