	<mx:Text styleName="textStyle11" x="896" y="64" width="228" text="制图@Csxylic米游社"/>
	<mx:Text styleName="textStyle8" x="736" y="224" width="448" alpha="0.9" text="角熊怒吼着扑而来，造成50%伤害，紧接着翻翼攻击，造成75%伤害。翼受损时不追加翻翼攻击。"/>
	<mx:Text styleName="textStyle8" x="736" y="480" width="448" alpha="0.9" text="角熊半起身，使用前肢击打一下，造成60%伤害，容易后接各种其他技能。"/>
	<mx:Text styleName="textStyle8" x="736" y="736" width="448" alpha="0.9" text="角熊张开翼进行蓄力，随后怒而自旋，造成100%伤害。受「星烁反应」影响后翼破损，不再能够继续使用；触发时掉落4枚火元素微粒。"/>
	<mx:Text styleName="textStyle9" x="736" y="160" width="448" text="猖炽趋退-位移"/>
