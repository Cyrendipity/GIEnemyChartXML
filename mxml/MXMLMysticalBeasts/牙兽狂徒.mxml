	<mx:Image source="Image3.png" x="64" y="877" width="484" height="124"/>
	<mx:Text styleName="textStyle10" x="1408" y="224" width="448" alpha="0.9" text="牙兽使用长鼻牵出大剑进行甩击，造成100%伤害，容易后接「涤恶韧炎」、「轰红之意」、「金象摧驰」。"/>
	<mx:Text styleName="textStyle10" x="1408" y="512" width="448" alpha="0.9" text="牙兽使用长鼻朝前抛出炎晶，造成70%伤害。"/>
	<mx:Text styleName="textStyle10" x="1408" y="800" width="448" alpha="0.9" text="牙兽掏出火水，进入酒狂：连续进行4段挥舞攻击，依次造成80%,80%,80%,100%伤害，重复3次；受「星烁反应」影响后变为醉乱：攻击失去目标，连续进行2段挥舞攻击，均造成80%伤害，重复5次，最后进行2段甩击，依次造成80%,100%伤害。"/>
	<mx:Text styleName="textStyle11" x="1408" y="160" width="448" text="斫罪长火-输出"/>
	<mx:Text styleName="textStyle11" x="1408" y="448" width="448" text="嗔灼如星-远程"/>
	<mx:Text styleName="textStyle11" x="1408" y="736" width="448" text="酣屠醉梦-爆发"/>
	<mx:Text styleName="textStyle12" x="896" y="64" width="228" text="制图@Csxylic米游社"/>
	<mx:Text styleName="textStyle10" x="736" y="224" width="448" alpha="0.9" text="牙兽使用大剑进行纵击，造成80%伤害，容易后接「斫罪长火」。"/>
	<mx:Text styleName="textStyle10" x="736" y="512" width="448" alpha="0.9" text="牙兽使用左拳进行重击，造成60%伤害，容易后接「斫罪长火」、「涤恶韧炎」。"/>
	<mx:Text styleName="textStyle10" x="736" y="800" width="448" alpha="0.9" text="牙兽使用尖锐獠牙进行前驱攻击，造成100%伤害，容易后接「斫罪长火」。"/>
