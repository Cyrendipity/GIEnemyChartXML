	<mx:Text styleName="textStyle" x="64" y="384" width="442" text="嵌合翼骏狮"/>
	<mx:Text styleName="textStyle2" x="576" y="64" width="522" text="全技能一图流"/>
	<mx:Text styleName="textStyle3" x="64" y="512" width="305" text="单体的协奏者"/>
	<mx:Text styleName="textStyle4" x="64" y="832" width="305" alpha="0.9" text="抗性数据(单位%)"/>
	<mx:Text styleName="textStyle5" x="1387" y="64" width="469" alpha="0.5" text="元素能量：EP[0x2],EO[66,33]"/>
	<mx:Text styleName="textStyle6" x="64" y="672" width="305" text="HP: 1328385 (21.8F)"/>
	<mx:Text styleName="textStyle7" x="64" y="640" width="305" alpha="0.75" text="首领 Lv.103 Data"/>
	<mx:Text styleName="textStyle6" x="64" y="720" width="375" text="ATK: 19842 (7.6B2)"/>
	<mx:Text styleName="textStyle6" x="64" y="768" width="375" text="Wt/Ed: 300/4000"/>
	<mx:Text styleName="textStyle8" x="64" y="465" width="395" alpha="0.75" text="Chimeric Winged Lion"/>
	<mx:Text styleName="textStyle9" x="64" y="555" width="395" alpha="0.75" text="Solo Accompanist"/>
	<mx:Image source="Image4.png" x="64" y="877" width="484" height="124"/>
	<mx:Text styleName="textStyle10" x="736" y="224" width="448" alpha="0.9" text="战斗开始时，翼骏师进入「唤雷」形态，并展开幻雷护罩，该状态持续直至护罩被破坏。"/>
	<mx:Text styleName="textStyle10" x="736" y="448" width="448" alpha="0.9" text="距离较远时，翼骏狮升空，衔着雷剑向玩家突击，造成100%伤害，若玩家距离较近，则还会追加一段翻尾攻击，造成60%伤害。"/>
	<mx:Text styleName="textStyle10" x="736" y="672" width="448" alpha="0.9" text="翼骏狮将雷剑插入地面，并对其施加强风，使其产生冲击地波，每次造成60%伤害，一共会形成4道冲击波。可受「星烁反应」影响。"/>
	<mx:Text styleName="textStyle10" x="1408" y="224" width="448" alpha="0.9" text="翼骏狮使用左右双爪先后进行攻击，均造成30%伤害，若玩家距离较近，则还会追加一段翻尾攻击，造成60%伤害。"/>
	<mx:Text styleName="textStyle10" x="736" y="896" width="448" alpha="0.9" text="翼骏狮利用双头施放双属性高能激光束，接触造成对应元素的50%,25%,10%,5%伤害。"/>
	<mx:Text styleName="textStyle10" x="1408" y="672" width="448" alpha="0.9" text="瘫痪恢复后，翼骏狮进入「驱风」形态，绕场地盘旋大半圈，并在途径的位置留下共8枚烈风弹。烈风弹依次朝玩家飞去，造成50%,25%,10%,5%伤害。"/>
	<mx:Text styleName="textStyle10" x="736" y="1120" width="448" alpha="0.9" text="翼骏狮短暂蓄力，突然朝玩家冲来并着陆，造成60%伤害，准备重新进入「唤雷」形态。"/>
	<mx:Text styleName="textStyle10" x="1408" y="448" width="448" alpha="0.9" text="距离较远时，翼骏狮吐出5枚雳珠，并加以强化，朝着玩家飞去，造成40%,20%,10%,4%伤害。"/>
	<mx:Text styleName="textStyle11" x="1408" y="608" width="448" text="腾驭越逐-远程"/>
	<mx:Text styleName="textStyle11" x="736" y="1056" width="448" text="寸飙鸢狩-输出"/>
	<mx:Text styleName="textStyle11" x="736" y="832" width="448" text="势动苍霆-猛攻"/>
	<mx:Text styleName="textStyle11" x="736" y="160" width="448" text="凛谷深雷-防御"/>
	<mx:Text styleName="textStyle11" x="736" y="384" width="448" text="横刃碎牙-猛攻"/>
	<mx:Text styleName="textStyle11" x="736" y="608" width="448" text="威淬万钧-爆发"/>
	<mx:Text styleName="textStyle11" x="1408" y="160" width="448" text="摧灾折败-输出"/>
	<mx:Text styleName="textStyle11" x="1408" y="384" width="448" text="衍雷并巽-远程"/>
	<mx:Text styleName="textStyle12" x="896" y="64" width="228" text="制图@Csxylic米游社"/>
	<mx:Text styleName="textStyle13" x="64" y="1128" width="448" alpha="0.75" text="幻雷护罩：12雷盾，击破可使其瘫痪12s；受到「星烁反应」影响-4雷。第2/3次及之后展开护罩的厚度为8/6雷。风球：可被火/水/雷/冰攻击击毁，翼骏狮吸收不到足够的风球会瘫痪，持续16s。"/>
