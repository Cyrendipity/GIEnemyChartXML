	<mx:Text styleName="textStyle7" x="64" y="465" width="395" alpha="0.75" text="Guardian Blade of Drifting Snow"/>
	<mx:Image source="Image4.png" x="64" y="845" width="484" height="124"/>
	<mx:Text styleName="textStyle8" x="1408" y="160" width="448" text="云泻州河-位移"/>
	<mx:Text styleName="textStyle8" x="1408" y="448" width="448" text="死寒碎壑-远程"/>
	<mx:Text styleName="textStyle8" x="1408" y="736" width="448" text="凝秉六境-爆发"/>
	<mx:Text styleName="textStyle9" x="1408" y="224" width="448" alpha="0.9" text="雪精突刺而来，造成100%伤害，若玩家距离较近，则后接「冬锷游锋」。"/>
	<mx:Text styleName="textStyle9" x="1408" y="512" width="448" alpha="0.9" text="雪精召唤6枚冰棱箭，以三枚一组的方式施放追踪玩家，均造成25%伤害。"/>
	<mx:Text styleName="textStyle9" x="1408" y="800" width="448" alpha="0.9" text="雪精展开「冰棺」的同时，会在上空不断生成6枚冰长枪，并在蓄力完成后依次朝玩家发射而来，均造成60%,6%伤害，同时额外造成15%伤害。"/>
	<mx:Text styleName="textStyle10" x="896" y="64" width="228" text="制图@Csxylic米游社"/>
	<mx:Text styleName="textStyle9" x="736" y="224" width="448" alpha="0.9" text="雪精使用双刃进行一次华丽的旋身攻击，造成80%伤害。"/>
	<mx:Text styleName="textStyle9" x="736" y="512" width="448" alpha="0.9" text="雪精进行至多4段的普通攻击，运动幅度越来越大，依次造成30%,30%,40%,40%伤害。"/>
	<mx:Text styleName="textStyle9" x="736" y="800" width="448" alpha="0.9" text="雪精在低于50%生命值时，会将自己封入「冰棺」；展开「冰棺」进行蓄力时会在周围产生冰风暴，持续造成3.125%伤害，16s后解除并施放「凝秉六境」，同时恢复20%生命值，仅触发一次。受「星烁反应」影响，冰棺会更容易被雷元素/风元素破坏。"/>
	<mx:Text styleName="textStyle8" x="736" y="160" width="448" text="冬锷游锋-输出"/>
	<mx:Text styleName="textStyle8" x="736" y="448" width="448" text="饰霜镜华-输出"/>
	<mx:Text styleName="textStyle8" x="736" y="736" width="448" text="杵愿遗影-防御"/>
	<mx:Text styleName="textStyle11" x="736" y="1024" width="448" alpha="0.75" text="冰棺：20冻盾/40冻盾(深渊)，击破会使其扣除20%生命值，同时虚弱15s。「星烁反应」会使雷/风的相应反应消耗比变为1:4。"/>
	<mx:Text styleName="textStyle12" x="64" y="512" width="394" text="离群的冰影"/>
	<mx:Text styleName="textStyle13" x="64" y="555" width="395" alpha="0.75" text="Outcast Ice Shadow"/>
