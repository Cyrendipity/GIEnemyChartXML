	<mx:Text styleName="textStyle11" x="736" y="256" width="448" alpha="0.9" text="嗥狼以站姿迅速拈弓一发冰箭，造成60%伤害；或以蹲姿发射，造成70%伤害。"/>
	<mx:Text styleName="textStyle11" x="736" y="704" width="448" alpha="0.9" text="嗥狼给弓注入冰元素，随后发射三枚极快的追踪箭，造成100%,20%,10%伤害。受「星烁反应」影响后箭失去目标，并会使其眩晕一小会。"/>
	<mx:Text styleName="textStyle11" x="736" y="480" width="448" alpha="0.9" text="嗥狼蹲下迅速发射两一枚冰箭，均造成50%伤害。"/>
	<mx:Text styleName="textStyle12" x="736" y="192" width="448" text="幻雪零星-远程"/>
