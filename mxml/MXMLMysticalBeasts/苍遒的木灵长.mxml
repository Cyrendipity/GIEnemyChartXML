	<mx:Text styleName="textStyle7" x="896" y="64" width="228" text="制图@Csxylic米游社"/>
	<mx:Text styleName="textStyle8" x="64" y="384" width="518" text="苍遒的木灵长"/>
	<mx:Text styleName="textStyle9" x="64" y="1068" width="448" alpha="0.75" text="虬须：34%生命值护罩，击中树心即可立即破坏，中断扎根，期间火抗-200%。"/>
	<mx:Text styleName="textStyle10" x="736" y="256" width="448" alpha="0.9" text="树妖从地里面扣出一块晶髓，扔向玩家，造成100%伤害。"/>
	<mx:Text styleName="textStyle10" x="736" y="480" width="448" alpha="0.9" text="树妖突然跃起，并重重击地，造成100%伤害。持有「灵髓」时攻击造成岩元素伤害，且伤害倍率提升，造成125%伤害。"/>
	<mx:Text styleName="textStyle10" x="736" y="704" width="448" alpha="0.9" text="树妖进行3段普通攻击，依次造成50%,50%,70%伤害。持有「灵髓」时攻击造成岩元素伤害，且伤害倍率提升，依次造成75%,75%,100%伤害。"/>
	<mx:Text styleName="textStyle11" x="736" y="192" width="448" text="击木弹石-远程"/>
	<mx:Text styleName="textStyle11" x="736" y="416" width="448" text="形槁戒惧-位移"/>
	<mx:Text styleName="textStyle11" x="736" y="640" width="448" text="盘梢髓岩-输出"/>
	<mx:Text styleName="textStyle12" x="64" y="512" width="373" text="生于灵野的树妖"/>
	<mx:Text styleName="textStyle13" x="64" y="555" width="395" alpha="0.75" text="Leshy Born of the Mystic Wilds"/>
