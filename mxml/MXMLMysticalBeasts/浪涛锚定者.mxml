	<mx:Image source="Image4.png" x="64" y="909" width="484" height="124"/>
	<mx:Text styleName="textStyle10" x="1408" y="224" width="448" alpha="0.9" text="锚定者侧方向使用巨锚猛击，造成60%伤害。"/>
	<mx:Text styleName="textStyle10" x="1408" y="448" width="448" alpha="0.9" text="距离较远时，锚定者举着锚飞过来下砸，造成80%伤害。"/>
	<mx:Text styleName="textStyle10" x="1408" y="672" width="448" alpha="0.9" text="「奋勇」状态下特定技能结束或处于侧后方时，锚定者翘起尾部，转身横扫一次，接触造成75%伤害。"/>
	<mx:Text styleName="textStyle10" x="1408" y="896" width="448" alpha="0.9" text="「奋勇」状态下，锚定者用力挥舞巨锚进行连续5段的攻击，依次造成50%,50%,50%,50%,75%伤害。"/>
	<mx:Text styleName="textStyle10" x="736" y="1120" width="448" alpha="0.9" text="锚定者会不间断进行「小酌」或「酣饮」，增加自身的「豪意值」。该值满时，锚定者会进入「奋勇」状态，持续80s，该状态下豪意值会不断衰减，清空时会中断当前动作并退出「奋勇」。受到雷元素伤害时，豪意值会额外减少。"/>
	<mx:Text styleName="textStyle11" x="896" y="64" width="228" text="制图@Csxylic米游社"/>
	<mx:Text styleName="textStyle10" x="736" y="224" width="448" alpha="0.9" text="锚定者使用巨锚挥舞两下，依次造成40%,40%伤害。"/>
	<mx:Text styleName="textStyle10" x="736" y="448" width="448" alpha="0.9" text="距离较近时，锚定者举起巨锚，进行一次下砸，造成70%伤害。"/>
	<mx:Text styleName="textStyle10" x="736" y="672" width="448" alpha="0.9" text="「奋勇」状态下距离较远时，锚定者握拳飞过来猛击，造成100%伤害，一般后随「归涛奏溯」。"/>
	<mx:Text styleName="textStyle10" x="736" y="896" width="448" alpha="0.9" text="「奋勇」状态下距离较远时，锚定者喷射水流从下往上扫，造成60%伤害，水注留下一些泉眼，一段时间后喷发造成40%伤害。一般后随「归涛奏溯」。"/>
	<mx:Text styleName="textStyle12" x="1408" y="160" width="448" text="擎桅转舷-输出"/>
	<mx:Text styleName="textStyle12" x="1408" y="384" width="448" text="震涡坠载-位移"/>
	<mx:Text styleName="textStyle12" x="1408" y="608" width="448" text="归涛奏溯-防御"/>
	<mx:Text styleName="textStyle12" x="1408" y="832" width="448" text="骇武顽浪-猛攻"/>
	<mx:Text styleName="textStyle12" x="736" y="160" width="448" text="锋近定海-输出"/>
	<mx:Text styleName="textStyle12" x="736" y="384" width="448" text="纵礁沉破-输出"/>
	<mx:Text styleName="textStyle12" x="736" y="608" width="448" text="擂襟鸷击-位移"/>
	<mx:Text styleName="textStyle12" x="736" y="832" width="448" text="奔涣渊潮-远程"/>
