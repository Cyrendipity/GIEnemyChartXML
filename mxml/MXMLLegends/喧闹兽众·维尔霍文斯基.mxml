	<mx:Image source="Image5.png" x="64" y="1097" width="484" height="60"/>
	<mx:Text styleName="textStyle8" x="0" y="1055" width="64" text="正常"/>
	<mx:Text styleName="textStyle8" x="0" y="1115" width="64" text="虚弱"/>
	<mx:Text styleName="textStyle9" x="64" y="1164" width="448" alpha="0.75" text="支援护罩·柔：48水盾，持续30s，受「星烁反应」影响，当护罩受到雷/风/冰元素伤害时，根据所受攻击的元素量，扣除4水(2单位以下)或8水(2单位及以上)，击破后三者虚弱15s。支援护罩·刚：全体生命盾，继承狮獒自身30%生命值，持续30s，击破后三者虚弱15s。若护罩超时未击破，那么所有成员都恢复25%生命值，同时提高25%攻击力。"/>
	<mx:Text styleName="textStyle10" x="736" y="864" width="448" text="跃引投猎-位移"/>
	<mx:Text styleName="textStyle10" x="736" y="1088" width="448" text="开冰錾岩-爆发"/>
	<mx:Text styleName="textStyle10" x="736" y="1344" width="448" text="风雨胶漆-辅助"/>
	<mx:Text styleName="textStyle11" x="736" y="256" width="448" alpha="0.9" text="狮獒使用铲子铲起砂石，朝玩家扔来，造成80%伤害。"/>
	<mx:Text styleName="textStyle11" x="736" y="480" width="448" alpha="0.9" text="狮獒使用十字镐敲击，造成65%伤害。"/>
	<mx:Text styleName="textStyle11" x="736" y="704" width="448" alpha="0.9" text="狮獒使用铲子转身回旋，造成100%伤害，随后摔倒。"/>
	<mx:Text styleName="textStyle11" x="736" y="928" width="448" alpha="0.9" text="狮獒飞击，顺势进行十字斩，造成80%伤害，随后翻身。"/>
	<mx:Text styleName="textStyle11" x="736" y="1152" width="448" alpha="0.9" text="狮獒趴下并蓄力。随后使用镐和铲交替进行攻击，分别造成65%,100%伤害,重复4次后停下。受「星烁反应」影响后，狮獒每进行2段攻击，就会被打断，第三次被打断则直接击飞。"/>
	<mx:Text styleName="textStyle11" x="736" y="1408" width="448" alpha="0.9" text="进行「情谊佑助」时，负责维持支援护罩·柔。低于50%生命值时，其余2位兽众将加入战斗并保护狮獒，渠联展开支援护罩·刚并持续召唤下落水果攻击，长耳每3s产生排斥风场。受保护时生命值不会低于25%。"/>
	<mx:Text styleName="textStyle10" x="736" y="192" width="448" text="归沙捷砾-远程"/>
	<mx:Text styleName="textStyle10" x="736" y="416" width="448" text="浅探深凿-输出"/>
