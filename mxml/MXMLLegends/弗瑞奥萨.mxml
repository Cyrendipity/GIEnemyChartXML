	<mx:Text styleName="textStyle5" x="736" y="256" width="448" alpha="0.9" text="弗瑞奥萨以站姿迅速拈弓一发冰箭，造成60%伤害；或以蹲姿发射，造成70%伤害。"/>
	<mx:Text styleName="textStyle5" x="736" y="704" width="448" alpha="0.9" text="弗瑞奥萨给弓注入冰元素，随后发射三枚极快的追踪箭，造成90%,18%,9%伤害。受「星烁反应」影响后箭失去目标，并会使其眩晕一小会。"/>
	<mx:Text styleName="textStyle5" x="736" y="1376" width="448" alpha="0.9" text="弗瑞奥萨遁入地面，在目标处留下「阻生根须」，1.5s后现身。根须受「星烁反应」影响后会变矮，受击即可破坏，无论位置。"/>
	<mx:Text styleName="textStyle5" x="736" y="480" width="448" alpha="0.9" text="弗瑞奥萨蹲下迅速发射两一枚冰箭，均造成50%伤害。"/>
	<mx:Text styleName="textStyle5" x="736" y="928" width="448" alpha="0.9" text="距离较近时，弗瑞奥萨使用下肢进行踢踹攻击，造成60%伤害。"/>
	<mx:Text styleName="textStyle5" x="736" y="1152" width="448" alpha="0.9" text="弗瑞奥萨缠根，并在两侧留下根须；同时持续发射7波箭雨，前6波箭雨持续造成50%,25%,10%,5%伤害，第7波箭雨虽迟但痛，造成100%,20%,10%伤害。"/>
	<mx:Text styleName="textStyle6" x="736" y="192" width="448" text="幻雪零星-远程"/>
	<mx:Text styleName="textStyle6" x="736" y="640" width="448" text="流矢烁寒-追踪"/>
	<mx:Text styleName="textStyle6" x="736" y="416" width="448" text="雨前三两-远程"/>
	<mx:Text styleName="textStyle6" x="736" y="864" width="448" text="凌冰微舞-输出"/>
	<mx:Text styleName="textStyle6" x="736" y="1088" width="448" text="急雪连霖-爆发"/>
