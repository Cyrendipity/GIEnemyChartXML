	<mx:Text styleName="textStyle" x="64" y="384" width="463" text="冰结镜映体"/>
	<mx:Text styleName="textStyle2" x="576" y="64" width="522" text="全技能一图流"/>
	<mx:Text styleName="textStyle3" x="64" y="512" width="305" text="无神智的游荡者"/>
	<mx:Text styleName="textStyle4" x="1247" y="64" width="609" alpha="0.5" text="元素能量：CP[66,33,0]"/>
	<mx:Text styleName="textStyle5" x="64" y="672" width="305" text="HP: 499140 (9.0F)"/>
	<mx:Text styleName="textStyle6" x="64" y="640" width="305" alpha="0.75" text="精英 Lv.100 Data"/>
	<mx:Text styleName="textStyle5" x="64" y="720" width="375" text="ATK: 12311 (5.0B2)"/>
	<mx:Text styleName="textStyle5" x="64" y="768" width="375" text="Wt/Ed: 150/210"/>
	<mx:Text styleName="textStyle7" x="64" y="465" width="395" alpha="0.75" text="Icebound Reflection"/>
	<mx:Text styleName="textStyle8" x="64" y="555" width="395" alpha="0.75" text="Witless Wanderer"/>
	<mx:Text styleName="textStyle9" x="1408" y="160" width="448" text="顷锋收斫-位移"/>
	<mx:Text styleName="textStyle9" x="1408" y="480" width="448" text="灯雪闪璨-远程"/>
	<mx:Text styleName="textStyle9" x="1408" y="768" width="448" text="畴染臻灭-天赋"/>
	<mx:Text styleName="textStyle10" x="1408" y="224" width="448" alpha="0.9" text="位于远处时，冰镜作势，短暂停留并迅速冲击，造成90%伤害，通常施放2次。"/>
	<mx:Text styleName="textStyle10" x="1408" y="544" width="448" alpha="0.9" text="位于远处时，冰镜凝结霜露，从中持续释放出约22枚追踪冰晶，均造成45%,22.5%,4.5%伤害。"/>
	<mx:Text styleName="textStyle10" x="1408" y="832" width="448" alpha="0.9" text="冰镜初始自附着2单位冻元素且免疫冰元素伤害与冻结，受「星烁反应」影响后失去附着与免疫，同时外观也变得更为黯淡。"/>
	<mx:Text styleName="textStyle11" x="896" y="64" width="228" text="制图@Csxylic米游社"/>
	<mx:Text styleName="textStyle10" x="736" y="224" width="448" alpha="0.9" text="冰镜进行2段的抓划攻击，均造成65%伤害；若玩家位于侧方，则追加一段扫尾攻击造成80%伤害。"/>
	<mx:Text styleName="textStyle10" x="736" y="544" width="448" alpha="0.9" text="位于近处时，冰镜将凝结尖冰，随后掷向地面爆裂，造成100%伤害。"/>
	<mx:Text styleName="textStyle10" x="736" y="832" width="448" alpha="0.9" text="处于侧方时，冰镜将直接进行甩尾攻击，造成80%伤害。"/>
	<mx:Text styleName="textStyle9" x="736" y="160" width="448" text="猎骨留痕-输出"/>
	<mx:Text styleName="textStyle9" x="736" y="480" width="448" text="碎镜凛枝-输出"/>
	<mx:Text styleName="textStyle9" x="736" y="768" width="448" text="轮掣翻棱-防御"/>
